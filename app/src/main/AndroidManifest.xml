<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Removed until the feature behind each one really exists (Play reviews every one of these
      and rejects "declared but unused"):
        ACCESS_BACKGROUND_LOCATION -> add with a real geofence/location service + in-app disclosure
        QUERY_ALL_PACKAGES         -> restricted; needs a Play declaration form
        SYSTEM_ALERT_WINDOW        -> restricted; needs justification
        BIND_DEVICE_ADMIN          -> not a uses-permission. Belongs on a DeviceAdminReceiver <receiver>.
    -->

    <application
        android:name=".NestCheckApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NestCheck">
        <!-- Google Maps API Key for Live Location & Geofencing -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyNestCheckSafetyDemoDevelopmentKey123" />

        <activity
            android:name=".ParentMainActivity"
            android:exported="true"
            android:label="NSP"
            android:launchMode="singleTask"
            android:taskAffinity="com.nestcheck.app.parent"
            android:theme="@style/Theme.NestCheck">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".KidMainActivity"
            android:exported="true"
            android:label="NSC"
            android:launchMode="singleTask"
            android:taskAffinity="com.nestcheck.app.kid"
            android:theme="@style/Theme.NestCheck">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.NestCheck" />

        <!-- Sinan's Feature Receivers & Services (F7 & F9) -->
        <receiver
            android:name=".service.AppInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.MediaScannerService"
            android:exported="false" />

        <!-- Anti-Tamper & Bypass Monitor Receiver -->
        <receiver
            android:name=".core.TamperMonitorReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.AIRPLANE_MODE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Sinan's Realtime Screen Time & Credit Tracking Service -->
        <service
            android:name=".service.ScreenTimeService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />
    </application>

</manifest>